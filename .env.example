# Anthropic — usada apenas no serverless /api/anthropic (NUNCA exposta ao navegador)
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — para o app v2 (Vite/React), precisa do prefixo VITE_ pra ser injetado no bundle
VITE_SUPABASE_URL=https://euktswsroqgvewzqappq.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Caixa de e-mail que recebe as notas fiscais (mostrada na Caixa de entrada).
# Sem ela, a tela fala em "a caixa de e-mail configurada".
VITE_EMAIL_NOTAS=financeiro@suaempresa.com.br

# ---------------------------------------------------------------------------
# Anexos que chegam como LINK no corpo do e-mail (portais de contabilidade)
# ---------------------------------------------------------------------------
# Remetentes varridos MESMO sem anexo MIME (o G-Click manda a guia por link).
# Lista separada por vírgula. Padrão: gclick.com.br
EMAIL_REMETENTES_LINK=gclick.com.br

# Remetentes de confiança: o anexo deles é lido mesmo quando o e-mail foi
# endereçado só à caixa pessoal (ex.: o escritório respondendo uma dúvida).
EMAIL_REMETENTES_CONFIAVEIS=jlramos.com.br,gclick.com.br

# Escopo da busca. Por padrão o robô varre todas as caixas da conta conectada.
# Deixe true para voltar a olhar só o alias de GMAIL_TARGET_ALIAS.
GMAIL_SO_ALIAS=false
# Só estes tipos de anexo são considerados documento fiscal.
EMAIL_TIPOS_ARQUIVO=pdf,xml

# ---------------------------------------------------------------------------
# Triagem de anexos (evita assinatura de e-mail virando pendência)
# ---------------------------------------------------------------------------
# Quando o e-mail tem PDF/XML, só o PDF/XML é lido — a imagem que veio junto é
# o logotipo do rodapé. Quando NÃO tem nenhum PDF/XML, a imagem só é lida se
# for maior que este piso (em bytes): nota fotografada é pesada, logotipo de
# assinatura é leve. Padrão: 80000 (~80 KB).
EMAIL_IMAGEM_MINIMA_BYTES=80000

# Orçamento de tempo por execução, em milissegundos. A função é cortada pela
# Vercel em 60 s (vercel.json) e cada anexo custa uma chamada de IA. Antes de
# começar cada mensagem nova o robô confere o relógio e, se já passou disto,
# encerra devolvendo o lote parcial com sucesso (em vez de morrer com HTTP 504).
# O que ficou para trás entra na rodada seguinte. Padrão: 45000 (45 s).
# Opcional: por padrão sai de EMAIL_LIMITE_FUNCAO_MS menos 30 s.
# EMAIL_ORCAMENTO_MS=270000
# Teto da função na Vercel (vercel.json). O orçamento acima sai daqui menos 30 s.
EMAIL_LIMITE_FUNCAO_MS=300000
# Quanto supor que uma mensagem custa, antes de medir (leitura de IA por anexo).
EMAIL_CUSTO_MENSAGEM_MS=25000

# ALLOWLIST de hosts de onde o cron pode baixar arquivo de link (comparação
# EXATA, inclusive o host final do redirect). Link dentro de e-mail é vetor de
# phishing e este código roda com a service role — nada fora desta lista baixa.
# Padrão: app.gclick.com.br,innubem-prod.s3.amazonaws.com
EMAIL_LINKS_DOMINIOS=app.gclick.com.br,innubem-prod.s3.amazonaws.com

# ---------------------------------------------------------------------------
# Custo da leitura de IA e teto de gasto do mês
# ---------------------------------------------------------------------------
# Cada anexo lido é uma chamada paga à Anthropic. Toda leitura vira uma linha
# na tabela leituras_ia, com o custo em dólar, a cotação do dia e o custo em
# real — é daí que sai o "quanto custou" mostrado na tela.
#
# Teto de gasto do MÊS, em reais. Quando o total do mês encosta neste valor, o
# robô para de ler e devolve a rodada avisando que chegou no teto; o que sobrou
# volta quando o mês virar ou quando este número subir. Use 0 para não ter teto.
# Padrão: 50
EMAIL_TETO_MENSAL_BRL=50
