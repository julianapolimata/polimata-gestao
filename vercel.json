{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/email-cron.js": { "maxDuration": 60 },
    "api/anthropic.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/v2", "destination": "/v2/index.html" },
    { "source": "/v2/", "destination": "/v2/index.html" },
    { "source": "/v2/((?!assets/|favicon).*)", "destination": "/v2/index.html" }
  ]
}
